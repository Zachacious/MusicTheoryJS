---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "MusicTheoryJS — music theory library for JavaScript & TypeScript",
  description = "A music theory library for JavaScript and TypeScript: notes, scales, chords, keys, rhythm, sequencing, MIDI, notation, audio analysis, and microtonal tunings. Zero dependencies, fully typed.",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
/** Absolute origin, required for share-card metadata. */
const site = new URL(base, Astro.site ?? "https://musictheoryjs.com").href;
const docs = `${base}guides/getting-started/`;
const api = `${base}api/`;
const github = "https://github.com/Zachacious/MusicTheoryJS";
const npm = "https://www.npmjs.com/package/musictheoryjs";

// Structured data for search engines: this page describes an open-source
// JS/TS library, so SoftwareSourceCode is the matching schema.org type.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "MusicTheoryJS",
  description,
  url: site,
  codeRepository: github,
  programmingLanguage: ["TypeScript", "JavaScript"],
  runtimePlatform: ["Node.js", "Bun", "Deno", "browsers"],
  license: "https://opensource.org/licenses/ISC",
  author: { "@type": "Person", name: "Zach Moore" },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#0b0a10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MusicTheoryJS" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <!-- Link previews need a raster image at an absolute URL; an SVG favicon
         is ignored by most platforms. -->
    <meta property="og:image" content={`${site}og.jpg`} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="956" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}og.jpg`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Same Geist faces the docs theme (starlight-theme-black) registers,
         so the landing page and docs share one typeface. -->
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
    <style is:global>
      body {
        font-family: var(--font-geist), ui-sans-serif, system-ui, sans-serif;
      }
      .font-mono,
      pre,
      code {
        font-family: var(--font-geist-mono), ui-monospace, "SFMono-Regular", monospace;
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-white text-slate-700 antialiased selection:bg-violet-500/25 dark:bg-[#0b0a10] dark:text-slate-300"
  >
    <header
      class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-[#0b0a10]/80"
    >
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5"
      >
        <a href={base} class="flex items-center gap-2.5 font-semibold text-slate-900 dark:text-white">
          <img src={`${base}favicon.svg`} alt="" width="28" height="28" class="rounded-lg" />
          <span>MusicTheoryJS</span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href={docs} class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white">Docs</a>
          <a href={api} class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white">API</a>
          <a href={npm} class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/5 dark:hover:text-white">npm</a>
          <a
            href={github}
            class="ml-1 rounded-lg border border-slate-200 px-3 py-2 font-medium text-slate-700 transition hover:border-slate-300 hover:bg-slate-50 dark:border-white/10 dark:text-slate-200 dark:hover:bg-white/5"
            >GitHub</a
          >
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-200/70 dark:border-white/10">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-10 text-sm text-slate-500 sm:flex-row dark:text-slate-400"
      >
        <div class="flex items-center gap-2">
          <img src={`${base}favicon.svg`} alt="" width="20" height="20" class="rounded" />
          <span>MusicTheoryJS · ISC © 2020–2026 Zach Moore</span>
        </div>
        <div class="flex items-center gap-4">
          <a href={docs} class="hover:text-slate-800 dark:hover:text-white">Docs</a>
          <a href={api} class="hover:text-slate-800 dark:hover:text-white">API</a>
          <a href={github} class="hover:text-slate-800 dark:hover:text-white">GitHub</a>
          <a href={npm} class="hover:text-slate-800 dark:hover:text-white">npm</a>
        </div>
      </div>
    </footer>
  </body>
</html>
