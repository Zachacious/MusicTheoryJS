{
  "name": "musictheoryjs",
  "version": "3.1.0",
  "description": "A modern, tree-shakable music theory library with first-class support for non-standard tunings and microtonal music.",
  "type": "module",
  "sideEffects": false,
  "license": "ISC",
  "author": "Zach Moore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachacious/MusicTheoryJS.git"
  },
  "homepage": "https://musictheoryjs.com",
  "bugs": {
    "url": "https://github.com/Zachacious/MusicTheoryJS/issues"
  },
  "keywords": [
    "music",
    "theory",
    "note",
    "scale",
    "chord",
    "interval",
    "tuning",
    "microtonal",
    "edo",
    "just-intonation",
    "midi",
    "rhythm",
    "meter"
  ],
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "import": "./dist/collection/index.js",
      "require": "./dist/collection/index.cjs"
    },
    "./note": {
      "types": "./dist/note/index.d.ts",
      "import": "./dist/note/index.js",
      "require": "./dist/note/index.cjs"
    },
    "./interval": {
      "types": "./dist/interval/index.d.ts",
      "import": "./dist/interval/index.js",
      "require": "./dist/interval/index.cjs"
    },
    "./scale": {
      "types": "./dist/scale/index.d.ts",
      "import": "./dist/scale/index.js",
      "require": "./dist/scale/index.cjs"
    },
    "./chord": {
      "types": "./dist/chord/index.d.ts",
      "import": "./dist/chord/index.js",
      "require": "./dist/chord/index.cjs"
    },
    "./key": {
      "types": "./dist/key/index.d.ts",
      "import": "./dist/key/index.js",
      "require": "./dist/key/index.cjs"
    },
    "./rhythm": {
      "types": "./dist/rhythm/index.d.ts",
      "import": "./dist/rhythm/index.js",
      "require": "./dist/rhythm/index.cjs"
    },
    "./sequence": {
      "types": "./dist/sequence/index.d.ts",
      "import": "./dist/sequence/index.js",
      "require": "./dist/sequence/index.cjs"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js",
      "require": "./dist/analysis/index.cjs"
    },
    "./midi": {
      "types": "./dist/midi/index.d.ts",
      "import": "./dist/midi/index.js",
      "require": "./dist/midi/index.cjs"
    },
    "./notation": {
      "types": "./dist/notation/index.d.ts",
      "import": "./dist/notation/index.js",
      "require": "./dist/notation/index.cjs"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js",
      "require": "./dist/audio/index.cjs"
    },
    "./tuning": {
      "types": "./dist/tuning/index.d.ts",
      "import": "./dist/tuning/index.js",
      "require": "./dist/tuning/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun run scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "bench": "bun run bench/index.ts",
    "bench:vs": "bun run bench/vs.ts",
    "e2e": "bun run build && node scripts/e2e.mjs && node scripts/e2e.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun install && bun run build",
    "docs:preview": "cd docs && bun run preview",
    "changeset": "changeset",
    "release:cut": "bun run scripts/release.ts",
    "version": "changeset version && bun run scripts/sync-version.ts && biome check --write .",
    "release": "bun run build && changeset publish",
    "prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build && node scripts/e2e.mjs && node scripts/e2e.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.0",
    "@types/bun": "latest",
    "tinybench": "^6.1.2",
    "tonal": "^6.4.3",
    "typescript": "^5.7.0"
  }
}
