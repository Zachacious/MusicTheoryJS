{
  "name": "musictheoryjs",
  "version": "3.0.0",
  "description": "A tree-shakable music theory library",
  "main": "dist/musictheory.cjs.js",
  "module": "dist/musictheory.esm.js",
  "browser": "dist/musictheory.min.js",
  "types": "dist/musictheory.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/musictheory.esm.js",
      "require": "./dist/musictheory.cjs.js",
      "types": "./dist/musictheory.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "rollup -c -w",
    "build": "npm run clean && npm run build:types && rollup -c",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "music",
    "theory",
    "javascript"
  ],
  "author": "Zach Moore",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@types/bun": "latest",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-uglify": "^6.0.4",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zachacious/musictheoryjs"
  }
}
