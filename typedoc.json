{
  "entryPoints": [
    "src/core/index.ts",
    "src/pcset/index.ts",
    "src/dict/index.ts",
    "src/chord/index.ts",
    "src/scale/index.ts",
    "src/key/index.ts",
    "src/roman/index.ts",
    "src/progression/index.ts",
    "src/harmony/index.ts",
    "src/micro/index.ts",
    "src/tuning/index.ts"
  ],
  "out": "docs",
  "name": "MusicTheoryJS",
  "includeVersion": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "plugin": ["typedoc-material-theme"],
  "themeColor": "#4455ee",
  "theme": "default",
  "readme": "README.md",
  "categorizeByGroup": true,
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  },
  "treatValidationWarningsAsErrors": false
}
